# PostgreSQL
POSTGRES_USER=yemekhane
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=yemekhane
DATABASE_URL=postgresql+asyncpg://yemekhane:change_me_in_production@postgres:5432/yemekhane

# Redis
REDIS_URL=redis://redis:6379/0

# MQTT
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# API
JWT_SECRET=change_me_use_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
API_INTERNAL_KEY=edge_internal_key_change_me
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Edge gateway
EDGE_DEVICE_ID=reader-giris-1
EDGE_TENANT_ID=00000000-0000-0000-0000-000000000001
EDGE_TCP_LISTEN=:9000
EDGE_API_URL=http://api:8000
EDGE_MQTT_BROKER=tcp://mosquitto:1883
EDGE_DEVICE_API_KEY=dev_device_key_change_me
EDGE_METRICS_ADDR=:9090

# Frontend (build-time)
VITE_API_URL=http://localhost:8000

# Grafana
GRAFANA_ADMIN_PASSWORD=admin
